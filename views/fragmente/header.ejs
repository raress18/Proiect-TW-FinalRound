<header id="inceput_pagina">
    <div class="header-stanga">
        <a href="/resurse/imagini/sigla_mare.png" class="logo-link">
            <img src="/resurse/imagini/sigla.png" alt="Sigla FinalRound" title="Sigla magazinului">
        </a>
        <h1>FinalRound</h1>
    </div>

    <nav class="meniu-principal">
        <input type="checkbox" id="hamburger-toggle" class="hamburger-checkbox">
        <label for="hamburger-toggle" class="hamburger-label">
            <div class="hamburger-container">
                <span class="bara"></span>
                <span class="bara"></span>
                <span class="bara"></span>
            </div>
        </label>

        <ul class="meniu-lista">
            <li class="meniu-item acasa-item">
                <a href="/"><i class="fa-solid fa-house"></i> <span class="text-meniu">Acasă</span></a>
            </li>

            <li class="meniu-item cu-submeniu">
                <a href="/#bine-ati-venit"><i class="fa-solid fa-star"></i> <span class="text-meniu">Pagina
                        Curentă</span></a>
                <ul class="submeniu">
                    <li><a href="/#oferte-curente">Oferte Curente</a></li>
                    <li><a href="/#statistici">Statistici</a></li>
                    <li><a href="/#evenimente">Evenimente</a></li>
                </ul>
            </li>

            <!-- Etapa6: Optiune 'Produse' in meniu cu suboptiuni generate dinamic (toate, categ_1...) - req. 29 -->
            <li class="meniu-item cu-submeniu">
                <a href="/produse"><i class="fa-solid fa-box-open"></i> <span class="text-meniu">Produse</span></a>
                <ul class="submeniu">
                    <li><a href="/produse?tip=toate">Toate</a></li>
                    <% if (locals.categorii && locals.categorii.length> 0) { %>
                        <% for (let cat of locals.categorii) { %>
                            <li><a href="/produse?tip=<%- cat %>"><%- cat.charAt(0).toUpperCase() + cat.slice(1) %></a>
                            </li>
                            <% } %>
                                <% } %>
                    <li><a href="/seturi">Seturi Produse</a></li>
                </ul>
            </li>


            <li class="meniu-item">
                <a href="/despre"><i class="fa-solid fa-circle-info"></i> <span class="text-meniu">Despre</span></a>
            </li>

            <li class="meniu-item">
                <a href="/contact"><i class="fa-solid fa-envelope"></i> <span class="text-meniu">Contact</span></a>
            </li>

            <li class="meniu-item d-flex align-items-center ms-3">
                <!-- Etapa6: Switch tema din Bootstrap pentru tema light/dark - req. 97, 99 -->
                <div class="form-check form-switch text-light">
                    <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch">
                    <label class="form-check-label text-meniu ms-1" for="themeSwitch">
                        <i class="bi bi-moon-stars-fill"></i>
                    </label>
                </div>
            </li>

        </ul>
    </nav>
</header>