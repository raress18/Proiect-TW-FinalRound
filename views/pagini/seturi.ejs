<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Seturi - FinalRound</title>
    <%- include("../fragmente/head.ejs") %>
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <link rel="stylesheet" href="/resurse/css/seturi.css" type="text/css" />
</head>

<body class="body-produse">
    <%- include("../fragmente/header.ejs") %>

        <main class="container-pagina-produse">
            <div class="wrapper-interior-produse">

                <div class="titlu-sectiune-produse">
                    <h2>Seturi Echipamente </h2>
                    <!--o sa apara cu majuscule ca am un text-transform:uppercase -->
                </div>

                <section class="lista-seturi">
                    <% if (locals.seturi && seturi.length> 0) { %>
                        <% for (let set of seturi) { %>
                            <article class="set-produs">
                                <h3 class="set-titlu"><%- set.nume_set %></h3>
                                <p class="set-descriere">"<%- set.descriere_set %>"</p>

                                <div class="set-pret-container">
                                    <strong>Preț Set (Redus): </strong>
                                    <span class="pret-valoare"><%- set.pret_redus %> RON</span>
                                </div>

                                <h4>Echipamente Incluse:</h4>
                                <div class="echipamente-incluse">
                                    <% for (let p of set.produse) { %>
                                        <div class="produs-card-mic">
                                            <a href="/produs/<%- p.id %>">
                                                <img src="/resurse/imagini/<%- p.imagine %>" alt="<%- p.nume %>"
                                                    onerror="this.src='/resurse/imagini/echipament_mic.jpg'">
                                                <span class="produs-nume"><%- p.nume %></span>
                                                <span class="produs-pret"><%- p.pret %> RON</span>
                                            </a>
                                        </div>
                                        <% } %>
                                </div>
                            </article>
                            <% } %>
                                <% } else { %>
                                    <div class="fara-seturi">
                                        <i class="fa-solid fa-box-open"></i>
                                        <p>Nu s-au găsit seturi în baza de date.</p>
                                    </div>
                                    <% } %>
                </section>

            </div>
        </main>

        <%- include("../fragmente/footer.ejs") %>
</body>

</html>